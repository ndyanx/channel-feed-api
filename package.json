{
  "name": "channel-feed-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API para listar videos / shorts / directos de un canal de YouTube (Fastify + TypeScript)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "warm": "node scripts/warm-impers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.7",
    "impers": "0.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
